# Copy this file to .env and fill it in. Never commit .env or share it:
# it holds your bot token. On Railway, put these in the service's Variables.

# Your bot's token, from @BotFather (/newbot).
BOT_TOKEN=

# The public https address of your Daybook, with no slash at the end.
APP_URL=https://daybook.example.com

# Who may use this server: Telegram @usernames or numeric user ids, comma-separated.
# Leave it empty and anyone who finds your bot can store their calendar here.
ALLOWED_USERS=@your_telegram_username

# Time zone for alerts until your phone reports its own (e.g. Asia/Singapore, Europe/London).
DEFAULT_TZ=Asia/Singapore

# docker compose + Caddy only: the domain Caddy gets an HTTPS certificate for
# (the same host as APP_URL).
DOMAIN=daybook.example.com

# Optional: plans from forwarded messages. With a key from the Claude Console,
# forwarded messages can be read by Claude, which suggests events and to-dos for
# you to check before anything is added. Each person also has to turn it on in
# Settings. Leave empty to keep it off.
ANTHROPIC_API_KEY=
# Claude model that reads them (default claude-opus-5-5).
AI_MODEL=
