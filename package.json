{
  "name": "calendar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p server && vite build",
    "build:server": "vite build -c vite.server.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server.mjs",
    "server": "npm run build && npm run build:server && npm start",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p server"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
